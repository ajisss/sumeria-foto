# Postgres (Neon via Vercel Marketplace: pakai connection string pooled)
DATABASE_URL=postgres://user:pass@localhost:5432/payhub
# Acak, >= 32 karakter: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Origin publik app (tanpa trailing slash)
APP_URL=http://localhost:3000
# Email (opsional di dev: link dicetak ke console)
RESEND_API_KEY=
EMAIL_FROM=PayHub <onboarding@resend.dev>
# Origin tambahan yang dipercaya, pisahkan koma (opsional)
EXTRA_TRUSTED_ORIGINS=
# Wajib untuk cron pembersihan harian di Vercel (>= 16 karakter, acak)
CRON_SECRET=
