{
  "name": "sumeria-payhub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file=.env.local server/dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "seed:owner": "tsx --env-file=.env.local server/scripts/seed-owner.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx --env-file=.env.local server/scripts/seed-demo.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
